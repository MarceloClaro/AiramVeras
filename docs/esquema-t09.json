{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "airam-cenarios-t09-v1",
  "title": "T09 agregado sem observacoes individuais",
  "type": "object", "additionalProperties": false,
  "required": ["versao_schema", "fontes", "contrato", "gate_temporal", "cenarios", "sensibilidade_meta_A", "outros_instrumentos", "limites"],
  "properties": {
    "versao_schema": {"const": "airam-cenarios-t09-v1"},
    "fontes": {"$ref": "#/$defs/fontes"},
    "contrato": {"$ref": "#/$defs/contrato"},
    "gate_temporal": {"$ref": "#/$defs/gate"},
    "cenarios": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["ano_escolar", "componente", "nivel", "turma", "cenario", "hipoteses", "meta_A", "meta_B_resumo"],
      "properties": {"ano_escolar": {"type": "integer"}, "componente": {"enum": ["LEITURA", "MATEMATICA"]},
        "nivel": {"enum": ["turma", "escola"]}, "turma": {"type": ["string", "null"]}, "cenario": {"type": "string"},
        "hipoteses": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "meta_A": {"$ref": "#/$defs/meta_A"}, "meta_B_resumo": {"$ref": "#/$defs/resumo_B"}}}},
    "sensibilidade_meta_A": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["ano_escolar", "componente", "nivel", "turma", "saidas", "meta_A"],
      "properties": {"ano_escolar": {"type": "integer"}, "componente": {"enum": ["LEITURA", "MATEMATICA"]},
        "nivel": {"enum": ["turma", "escola"]}, "turma": {"type": ["string", "null"]},
        "saidas": {"type": "integer", "minimum": 0}, "meta_A": {"$ref": "#/$defs/meta_A"}}}},
    "outros_instrumentos": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["ano_escolar", "componente", "nivel", "cadastros", "avaliados", "unidades", "categorias_contagens", "meta_A_status", "meta_B_status", "medidas_disponiveis"],
      "properties": {"ano_escolar": {"type": "integer"}, "componente": {"enum": ["ESCRITA", "FLUENCIA"]}, "nivel": {"const": "escola"},
        "cadastros": {"type": "integer", "minimum": 0}, "avaliados": {"type": "integer", "minimum": 0},
        "unidades": {"type": "array", "items": {"type": "string"}},
        "categorias_contagens": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "meta_A_status": {"const": "unidade_nao_aplicavel"}, "meta_B_status": {"const": "unidade_nao_aplicavel"},
        "medidas_disponiveis": {"type": "integer", "minimum": 0}}}},
    "limites": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "fontes": {"type": "object", "additionalProperties": false,
      "required": ["t05_publico_sha256", "t05_restrito_sha256", "config_sha256", "coletor_sha256"],
      "properties": {"t05_publico_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "t05_restrito_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "coletor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "contrato": {"type": "object", "additionalProperties": false,
      "required": ["tipo_resultado", "premissas", "unidade", "comparabilidade", "status_validacao"],
      "properties": {"tipo_resultado": {"const": "cenario_condicional"}, "premissas": {"type": "array", "items": {"type": "string"}},
        "unidade": {"type": "object", "required": ["meta_A", "meta_B"], "properties": {
          "meta_A": {"const": "estudantes_na_categoria_original"}, "meta_B": {"const": "acertos_por_estudante"}}},
        "comparabilidade": {"const": "mesma_base_observada_sem_validacao_longitudinal"},
        "status_validacao": {"const": "aritmetica_condicional_sem_validacao_pedagogica"}}},
    "gate": {"type": "object", "additionalProperties": false,
      "required": ["tipo_resultado", "prontidao_inputs_temporais", "previsao_temporal_validada", "cenarios_disponiveis", "motivos", "pendencias_modelo", "premissas", "unidade", "comparabilidade", "status_validacao"],
      "properties": {"tipo_resultado": {"const": "gate_documental_temporal"}, "prontidao_inputs_temporais": {"type": "boolean"},
        "previsao_temporal_validada": {"const": false}, "cenarios_disponiveis": {"const": true},
        "motivos": {"type": "array", "items": {"type": "string"}}, "pendencias_modelo": {"type": "array", "items": {"type": "string"}},
        "premissas": {"type": "array", "items": {"type": "string"}}, "unidade": {"const": "avaliacoes_e_vinculos_documentais"},
        "comparabilidade": {"enum": ["contrato_documental", "nao_comprovada"]}, "status_validacao": {"const": "sem_modelo_temporal_validado"}}},
    "meta_A": {"type": "object", "additionalProperties": false,
      "required": ["meta", "avaliados", "adequados", "alvo", "conversoes", "atingida", "acertos_ate_adequacao", "status", "adequados_projetados", "atingida_projetada", "entradas", "saidas", "entradas_minimas_com_perdas", "viavel", "fracao_projetada", "unidade"],
      "properties": {"meta": {"const": "A"}, "avaliados": {"type": "integer", "minimum": 0}, "adequados": {"type": "integer", "minimum": 0},
        "alvo": {"type": ["integer", "null"]}, "conversoes": {"type": ["integer", "null"]}, "atingida": {"type": ["boolean", "null"]},
        "acertos_ate_adequacao": {"type": "null"}, "status": {"enum": ["disponivel", "sem_avaliados"]},
        "adequados_projetados": {"type": ["integer", "null"]}, "atingida_projetada": {"type": ["boolean", "null"]},
        "entradas": {"type": "integer", "minimum": 0}, "saidas": {"type": "integer", "minimum": 0},
        "entradas_minimas_com_perdas": {"type": ["integer", "null"]}, "viavel": {"type": ["boolean", "null"]},
        "fracao_projetada": {"type": ["object", "null"], "required": ["numerador", "denominador"],
          "properties": {"numerador": {"type": "integer", "minimum": 0}, "denominador": {"type": "integer", "minimum": 1}}},
        "unidade": {"const": "estudantes_na_categoria_original"}}},
    "resumo_B": {"type": "object", "additionalProperties": false,
      "required": ["cadastros", "disponiveis", "ausentes", "unidade", "alvo_individual", "atingiram_observado", "atingiram_projetado", "lacunas_observadas", "lacunas_projetadas"],
      "properties": {"cadastros": {"type": "integer", "minimum": 0}, "disponiveis": {"type": "integer", "minimum": 0}, "ausentes": {"type": "integer", "minimum": 0},
        "unidade": {"const": "acertos_por_estudante"}, "alvo_individual": {"const": 18},
        "atingiram_observado": {"type": "integer", "minimum": 0}, "atingiram_projetado": {"type": "integer", "minimum": 0},
        "lacunas_observadas": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "lacunas_projetadas": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "meta_B": {"type": "object", "additionalProperties": false,
      "required": ["meta", "alvo", "lacuna", "atingida", "status", "observacao_indice", "acertos_observados", "oportunidades", "unidade", "ganho", "perda", "deslocamento_bruto", "deslocamento_realizado", "acertos_projetados", "lacuna_projetada", "atingida_projetada", "distancia_adequacao_condicional"],
      "properties": {"meta": {"const": "B"}, "alvo": {"type": ["integer", "null"]}, "lacuna": {"type": ["integer", "null"]}, "atingida": {"type": ["boolean", "null"]},
        "status": {"enum": ["disponivel", "prova_ausente"]}, "observacao_indice": {"type": "integer", "minimum": 0},
        "acertos_observados": {"type": ["integer", "null"]}, "oportunidades": {"type": ["integer", "null"]}, "unidade": {"const": "itens"},
        "ganho": {"type": "integer", "minimum": 0}, "perda": {"type": "integer", "minimum": 0}, "deslocamento_bruto": {"type": "integer"},
        "deslocamento_realizado": {"type": ["integer", "null"]}, "acertos_projetados": {"type": ["integer", "null"]},
        "lacuna_projetada": {"type": ["integer", "null"]}, "atingida_projetada": {"type": ["boolean", "null"]}, "distancia_adequacao_condicional": {"type": ["object", "null"]}}}
  }
}
