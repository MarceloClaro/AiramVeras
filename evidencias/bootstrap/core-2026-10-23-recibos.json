  "spec_textual": {
    "success": true,
    "spec_id": "TSPEC-a6e24d1b",
    "task": "SPEC-AIRAM-001: sonda de execução do especialista CAEd usando EXCLUSIVAMENTE estes agregados fornecidos, sem ler arquivos, sem comandos, sem rede e sem dados individuais. Dados: matemática 4º ano, N avaliado=42, Adequado CAEd=16; leitura 5º ano, N avaliado=53, Adequado CAEd=45. Meta A=80% avaliados Adequados. Instrumentos L/M têm22itens; Meta B=80%acertos por estudante. Responda em JSON com status, findings, evidence e limitations: teto de0,8N e conversões mínimas por cada um dos dois escopos; corte inteiro MetaB; declarar que essas contas agregadas não estabelecem corte oficial CAEd, previsão temporal ou eficácia pedagógica. Não revisar código nem repetir revisão de etapa. Evidência é somente o texto agregado desta solicitação, derivado do checkpoint público T05 autenticado SHA256 5bfa87b38394d171589a7799751127dceb7d81587bbbfcefa67d2bb4a8420231.",
    "criteria": [
      "MetaA matemática4: alvo34 e18conversões; leitura5: alvo43 e0conversões",
      "MetaB22itens: corte18; não inferir quem individualmente atende",
      "Declarar fonte textual agregada e limites; nenhuma leitura de arquivos, comando, rede ou dado individual"
    ],
    "verification": "criteria_only",
    "software_delivery": false,
    "externally_validated": false,
    "limitations": [
      "Critérios de texto são heurísticos; não comprovam qualidade ou correção.",
      "ID válido nesta sessão MCP; não constitui entrega de software nem substitui RED→GREEN."
    ]
  },
