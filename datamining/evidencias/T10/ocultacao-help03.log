{"kind":"api","name":"range.format.autofitColumns","summary":"Autofit column widths for a range.","tags":["range.format.autofitColumns"],"examples":[{"code":"sheet.getRange('A1:D20').format.autofitColumns();","summary":"Autofit columns for the range"}]}
{"kind":"api","name":"range.format.columnWidth","summary":"Set column width (Excel width units) for a range.","tags":["range.format.columnWidth"],"examples":[{"code":"sheet.getRange('A1:D10').format.columnWidth = 2.75;","summary":"Set column width to 2.75"}],"notes":["Use columnWidthPx for pixel-based layout sizing."]}
{"kind":"api","name":"range.format.columnWidthPx","summary":"Set column width (pixels) for a range.","tags":["range.format.columnWidthPx"],"examples":[{"code":"sheet.getRange('A1:D10').format.columnWidthPx = 120;","summary":"Set column width to 120px"}],"notes":["Pixels are preferred for layout-sensitive dashboards."]}
{"kind":"api","name":"range.getCell","summary":"Get a single cell inside a range by zero-based offsets.","tags":["range.getCell"],"examples":[{"code":"const range = sheet.getRange('B2:D4');\nconst cell = range.getCell(2, 2);","summary":"Access a cell relative to a range"}],"notes":["Row and column are 0-based offsets from the range's top-left cell."]}
{"kind":"api","name":"range.columnIndex","summary":"Return the 0-based column index for the range's top-left cell.","tags":["range.columnIndex"],"examples":[{"code":"const range = sheet.getRange('B2:D4');\nrange.columnIndex; // 1","summary":"Read the range origin column"}],"notes":["Throws if the range is not attached to a worksheet."]}
{"kind":"api","name":"range.getColumn","summary":"Return a single column inside a range by 0-based offset.","tags":["range.getColumn"],"examples":[{"code":"const range = sheet.getRange('B2:D4');\nconst col = range.getColumn(0); // B2:B4","summary":"Select a column inside a block"}]}
{"kind":"api","name":"range.getResizedRange","summary":"Return a range resized by delta rows/columns, anchored at the current top-left cell.","tags":["range.getResizedRange"],"examples":[{"code":"const range = sheet.getRange('B2:D4');\nconst wider = range.getResizedRange(0, 1); // B2:E4","summary":"Grow a range by one column"},{"code":"const range = sheet.getRange('B2:D4');\nconst smaller = range.getResizedRange(-1, -1); // B2:C3","summary":"Shrink a range by one row and one column"}],"notes":["Compatibility helper modeled after Office.js Range.getResizedRange(deltaRows, deltaColumns).","If you have a matrix and just want to write it starting at a single cell, prefer a spill write: sheet.getRange('B2').values = matrix."]}
{"kind":"api","name":"range.getResizeRange","summary":"Return a range resized to an explicit row/column count, anchored at the current top-left cell.","tags":["range.getResizeRange"],"examples":[{"code":"const range = sheet.getRange('B2:D4');\nconst block = range.getResizeRange(5, 2); // B2:C6","summary":"Resize to a specific shape"}],"notes":["Granola convenience helper (absolute size).","Equivalent to range.getOffsetRange(0, 0, rowCount, columnCount)."]}
{"kind":"api","name":"range.resize","summary":"Alias for range.getResizeRange(rowCount, columnCount).","tags":["range.resize"],"notes":["This is an absolute resize helper.","Use range.getResizedRange(deltaRows, deltaColumns) when you want Office.js-style delta resize."]}
{"kind":"api","name":"range.write","summary":"Write a 2D matrix anchored at this range's top-left (auto-sizes the target).","tags":["range.write"],"examples":[{"code":"const anchor = sheet.getRange('B2');\nconst block = anchor.write([['A','B'],[1,2],[3,4]]);\n// block is the resized range (B2:C4)\nblock.format.autofitColumns();","summary":"Write a matrix without computing the end cell"}],"notes":["Prefer this over hand-building A1 end-cells like 'B2:F17'.","You can pass overwrite: 'error' to prevent overwriting existing content.","1D input is treated as a single row (wrap as [[...]] for 2D)."]}
{"kind":"api","name":"range.values","summary":"Read or write cell values using a 2D array.","tags":["range.values"],"examples":[{"code":"const range = sheet.getRange('A1:C2');\nrange.values = [['Date', 'Dog', 'HR'], ['2025-01-02', 'Nova', 58]];","summary":"Write a values grid"}],"notes":["Values are string | number | boolean | Date | null.","Single-cell ranges spill to fit larger matrices.","Single-row ranges also accept 1D arrays (treated as a row).","Single-column ranges also accept 1D arrays (treated as a column).","Granola auto-fixes common transposed vectors for 1-row/1-col ranges (Nx1 vs 1xN).","Use range.values = null to clear contents."]}
{"kind":"api","name":"range.formulas","summary":"Read or write formulas using a 2D string array.","tags":["range.formulas"],"examples":[{"code":"sheet.getRange('A1:A3').values = [[5], [2], [3]];\nsheet.getRange('B1').formulas = [['=SUM(A:A)']];\nworkbook.recalculate();\nconst total = sheet.getRange('B1').values[0]?.[0];","summary":"Write a formula and recalculate"}],"notes":["Formula strings may include or omit the leading '='.","Single-cell ranges spill to fit larger matrices.","Single-row and single-column ranges also accept 1D arrays.","Granola auto-fixes common transposed vectors for 1-row/1-col ranges (Nx1 vs 1xN)."]}
{"kind":"api","name":"range.clear","summary":"Clear contents and/or formatting for a range.","tags":["range.clear"],"examples":[{"code":"sheet.getRange('A1:C10').clear();","summary":"Clear contents"},{"code":"sheet.getRange('A1:C10').clear({ applyTo: 'all' });","summary":"Clear contents and formats"}],"notes":["applyTo accepts 'contents', 'formats', or 'all'.","Clearing formats does not change row/column sizing.","Clearing ranges does not delete charts, shapes, or images."]}
{"kind":"api","name":"range.fillRight","summary":"Copy the first column right, shifting formulas.","tags":["range.fillRight"],"examples":[{"code":"const r = sheet.getRange('B2:F2');\nr.getCell(0, 0).formulasR1C1 = [['=RC[-1]*2']];\nr.fillRight();","summary":"Fill right like Excel drag-fill"}],"notes":["Copies formulas/values from the first column to the rest of the range.","Relative references are shifted per column."]}
{"kind":"api","name":"styles","summary":"Formatting ranges (fills, fonts, borders, number formats).","tags":["styles","range.format","formatting","number format","number_format","autofit","fill","font","borders"],"notes":["Use range.format.fill, range.format.font, and range.format.borders.","Set range.format.numberFormat or range.format.wrapText.","Use range.format.autofitColumns/Rows for sizing."]}
{"kind":"api","name":"formatting-quick-reference","summary":"Copy/paste snippets for common range formatting tasks.","tags":["styles","range.format","formatting","formatting-quick-reference","borders","alignment","number format","horizontal alignment","vertical alignment","wrap text"],"examples":[{"code":"const range = sheet.getRange('A1:D10');\n\n// Fill + font\nrange.format.fill = 'lt2';\nrange.format.font = { name: 'Calibri', size: 11, color: 'tx1' };\n\n// Bulk format (single object assignment)\nrange.format = {\n  fill: 'lt2',\n  font: { name: 'Calibri', size: 11, color: 'tx1' },\n  borders: { preset: 'outside', style: 'thin', color: '#D1D5DB' },\n  horizontalAlignment: 'center',\n  verticalAlignment: 'center',\n  wrapText: true,\n};\n\n// Theme token + transform (prefer this over manual hex shading)\nrange.getRow(0).format.fill = {\n  type: 'solid',\n  color: { type: 'theme', value: 'accent1', transform: { darken: 10 } },\n};\n\n// Borders (edge + inside presets or per-edge)\nrange.format.borders = { preset: 'outside', style: 'thin', color: '#D1D5DB' };\nrange.format.borders.getItem('EdgeBottom').style = 'thin';\nrange.format.borders.getItem('EdgeBottom').color = '#D1D5DB';\n\n// Alignment + wrapping\nrange.format.horizontalAlignment = 'center';\nrange.format.verticalAlignment = 'center';\nrange.format.wrapText = true;\n\n// Autofit\nrange.format.autofitColumns();\nrange.format.autofitRows();\n\n// Number formats\nrange.format.numberFormat = '0.00';\nsheet.getRange('E1:F2').format.numberFormat = [['0', '0.00'], ['0', '0.00']];","summary":"Formatting quick reference"}],"notes":["numberFormat accepts either a single string (broadcast) or a 2D string matrix matching the range size.","Patch-style font updates are supported via range.format.font = { ... } or range.format.setFont({ ... }).","Bulk updates are supported via range.format = { fill, font, borders, numberFormat, ... }."]}
